#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
#
# phonecam-setup - install or repair the virtual camera used by phonecam.
#
# Run this command after a package or kernel update if the virtual camera is
# missing. It needs root for the kernel module, so it asks for the password in
# a terminal window when it runs from a graphical session.
#
# The root part of the installation must not be a file of this directory: a
# process of the user can change that file, and the file runs as root. This
# command therefore installs the module script and its configuration with the
# owner root in /usr/local/lib/phonecam/, and then it runs that copy.
#
# This command stops the camera stream and the preview window of this user
# first. They hold the video device, and the root part of the installation
# sends no signal to a process.
#
set -euo pipefail

here=$(cd -- "$(dirname -- "$0")" && pwd)

# The script setup-v4l2loopback.sh is next to this command in the plugin
# directory, and in the bundle when the installer put this command into
# ~/.local/bin. Accept both layouts.
setup=""
for candidate in "$here/../setup-v4l2loopback.sh" \
                 "${XDG_DATA_HOME:-$HOME/.local/share}/phonecam/setup-v4l2loopback.sh"; do
  if [[ -f $candidate ]]; then
    setup=$(cd -- "$(dirname -- "$candidate")" && pwd)/$(basename "$candidate")
    break
  fi
done

[[ -n $setup ]] || {
  echo "phonecam-setup: the script setup-v4l2loopback.sh is missing." >&2
  echo "phonecam-setup: install the plugin again, or run the script from" >&2
  echo "phonecam-setup: ~/.local/share/phonecam/ directly." >&2
  exit 1
}

# --- stop the programs of this user -----------------------------------------
# This part runs as the user, before the password. A signal here can only reach
# a process of this user, also when the process number is used again.
"$here/phonecam" stop >/dev/null 2>&1 || true
pkill -u "$(id -u)" -f 'ffplay .*-window_title phonecam preview' 2>/dev/null || true

# The preview window ends by itself when the stream stops. Wait for it, because
# it holds the video device, and then let the root part remove the module.
for _ in $(seq 1 15); do
  pgrep -u "$(id -u)" -f 'ffplay .*-window_title phonecam preview' >/dev/null 2>&1 || break
  sleep 1
done

# --- the root part ----------------------------------------------------------
# The root part runs from a copy with the owner root, and never from the script
# of this directory. A process of the user can change that script, and the
# script runs as root.
#
# The copy holds the module script and the two configuration files of etc/.
# The module script finds the configuration in its own directory, so the copy
# is complete.
root_dir=/usr/local/lib/phonecam
root_setup=$root_dir/setup-v4l2loopback.sh
install_cmd=/usr/bin/install
src_dir=$(cd -- "$(dirname -- "$setup")" && pwd)
configs="etc/modprobe.d/v4l2loopback.conf etc/modules-load.d/v4l2loopback.conf"

[[ -x $install_cmd ]] || {
  echo "phonecam-setup: the program $install_cmd is missing (package coreutils)." >&2
  exit 1
}

# Install the copy only when a file differs, so that a repair needs one step.
need_install=0
cmp -s "$setup" "$root_setup" 2>/dev/null || need_install=1
for conf in $configs; do
  cmp -s "$src_dir/$conf" "$root_dir/$conf" 2>/dev/null || need_install=1
done

# Two ways to ask for the password, in this order:
#   1. a terminal that runs this command, with sudo,
#   2. the polkit dialog of the desktop (GNOME).
elevate=""
if [[ -t 0 ]]; then
  elevate=sudo
elif command -v pkexec >/dev/null 2>&1; then
  elevate=pkexec
else
  echo "phonecam-setup: no program asks for the password." >&2
  echo "phonecam-setup: run this command in a terminal:" >&2
  echo "phonecam-setup:   sudo $setup" >&2
  exit 1
fi

# The install program writes the files with the owner root and the group root.
# A user process cannot change them after that.
if ((need_install)); then
  echo "phonecam-setup: install the root part in $root_dir"
  "$elevate" "$install_cmd" -D -o root -g root -m 755 "$setup" "$root_setup"
  for conf in $configs; do
    "$elevate" "$install_cmd" -D -o root -g root -m 644 \
      "$src_dir/$conf" "$root_dir/$conf"
  done
fi

# Run the copy, and never the script of this directory. In a terminal, sudo
# keeps the permission for a short time, so the calls above and this call ask
# for the password one time.
exec "$elevate" "$root_setup"
